<script is:inline type="module">const m=document.getElementById("searchInput"),g=document.getElementById("typeFilter"),p=document.getElementById("industryFilter"),h=document.getElementById("categoryFilter"),y=document.getElementById("resultCount"),u=document.getElementById("noResults"),f=document.querySelectorAll(".partner-card"),L=document.querySelectorAll(".category-section");function o(){const a=m.value.toLowerCase().trim(),r=g.value.toLowerCase(),l=p.value.toLowerCase(),e=h.value;let n=0;L.forEach(t=>{const s=t.dataset.category||"",c=!e||s===e||s==="other";t.style.display=c?"":"none"}),f.forEach(t=>{const s=t.dataset.name||"",c=t.dataset.type||"",E=t.dataset.industry||"",d=t.closest(".category-section")?.dataset.category||"";if(e&&d!==e&&d!=="other"){t.style.display="none";return}const C=!a||s.includes(a),I=!r||c.includes(r),v=!l||E.includes(l),i=C&&I&&v;t.style.display=i?"":"none",i&&n++}),y&&(y.textContent=`${n} partner${n!==1?"s":""}`),u&&(u.style.display=n===0?"block":"none")}m?.addEventListener("input",o);g?.addEventListener("change",o);p?.addEventListener("change",o);h?.addEventListener("change",o);</script>


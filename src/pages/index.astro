---
// Production layout recovered from immutable deployment bb877ed5. Partner
// records remain Markdown-driven; new records join their partner-type group.
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PartnerCard from '../components/PartnerCard.astro';
const activePartners = (await getCollection('partners')).filter(p => p.data.status === 'active');
const categories = [
  {
    "key": "category-0",
    "types": [
      "creative partner"
    ],
    "order": [
      "story-first"
    ]
  },
  {
    "key": "category-1",
    "types": [
      "association partner",
      "media partner"
    ],
    "order": [
      "ilt",
      "lawyer-stories",
      "macdl",
      "modl"
    ]
  }
];
const categoryPartners = Object.fromEntries(categories.map(group => [group.key,
  activePartners.filter(p => group.types.includes(p.data.partnerType.toLowerCase())).sort((a, b) => {
    const rank = (id: string) => { const index = group.order.indexOf(id); return index < 0 ? 1000 : index; };
    return rank(a.id) - rank(b.id) || a.data.name.localeCompare(b.data.name);
  })]));
---

